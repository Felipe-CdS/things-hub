# things-hub settings on the Mac. Copy to .env (gitignored) and run: chmod 600 .env
# Read by bin/thub-classroom and skills/things-hub-collect/thub-send.

# Inbox (phase 1: through the SSH forward to the home server).
THUB_URL=http://127.0.0.1:8787
THUB_TOKEN=
# Cloudflare Access service token, once the inbox has its hostname (phase 2).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Google Cloud "Desktop app" OAuth client (docs/classroom-setup.md).
THUB_GOOGLE_CLIENT_ID=
THUB_GOOGLE_CLIENT_SECRET=
# Event account alias for Classroom, such as university.
THUB_CLASSROOM_ACCOUNT=
# Written by `make classroom-login`.
THUB_CLASSROOM_REFRESH_TOKEN=

# things-hub settings for the Mac tool (thub). Copy to
# ~/Library/Application Support/things-hub/.env (or point THUB_ENV_FILE at
# another path), fill in, and chmod 600: thub refuses a .env others can read.
# Variables set in the environment override this file. thub reads the
# repository-root .env only when THUB_ENV_FILE points at it.

# Inbox server. Phase 1: a local server or the SSH forward to the home server.
THUB_URL=http://127.0.0.1:8787
# The Mac sender's token, printed once by `thub-server sender add mac ... --reader`.
THUB_TOKEN=

# GitHub: the personal account the collector skill watches (reads use the
# Mac's existing gh login; no GitHub token is stored here).
THUB_GITHUB_LOGIN=felipe-cds

# Phase 2, once the inbox sits behind Cloudflare Access: the Mac's service token.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional.
# THUB_THINGS_MCP=uvx things-mcp
# THINGS_AUTH_TOKEN=  (Things URL-scheme token; empty reads it from the Things database)
# THUB_RUNS_DIR=/Users/<you>/Library/Application Support/things-hub/runs
# Per-run limits (POLICY.md):
# THUB_LIMIT_NEW_TODOS=25
# THUB_LIMIT_DELETES=10
# THUB_LIMIT_MOVES=50
# THUB_LIMIT_AREA_CHANGES=3

# Reserved for later sources (not read by thub yet): Google OAuth for
# Classroom and Gemini notes.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
