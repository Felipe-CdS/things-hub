<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for `make classroom-install`, which fills in @LABEL@, @REPO@,
     @HOME@ and @INTERVAL@ and loads the job for the logged-in user. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>@LABEL@</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>@REPO@/scripts/classroom-routine.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@REPO@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StartInterval</key>
	<integer>@INTERVAL@</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/things-hub/classroom.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/things-hub/classroom.log</string>
</dict>
</plist>
